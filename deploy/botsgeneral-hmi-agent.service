[Unit]
Description=botsgeneral HMI agent (localhost JSON snapshot)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botsgeneral
Environment=PYTHONPATH=/opt/botsgeneral
Environment=BOTSGENERAL_KEYS=/etc/botsgeneral/bybit_keys.txt
Environment=BOTSGENERAL_REPORT_CFG=/etc/botsgeneral/report.yaml
EnvironmentFile=-/etc/botsgeneral/hmi.env
ExecStart=/opt/botsgeneral/venv/bin/python -m botsgeneral hmi-agent --host 127.0.0.1 --port 8788
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
